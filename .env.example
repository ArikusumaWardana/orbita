NEON_AUTH_BASE_URL="https://<auth-host>/neondb/auth"
NEON_AUTH_COOKIE_SECRET="<random-secret-at-least-32-characters>"
NEON_DATA_API_URL="https://<data-api-host>/<database>/rest/v1"

# Trusted server-only connection for reminder cron. Never expose this value to the client.
DATABASE_URL="postgresql://<owner-connection-string>"

# Web Push
NEXT_PUBLIC_VAPID_PUBLIC_KEY="<vapid-public-key>"
VAPID_PRIVATE_KEY="<vapid-private-key>"
VAPID_SUBJECT="mailto:admin@example.com"

# Vercel Cron
CRON_SECRET="<random-secret>"
